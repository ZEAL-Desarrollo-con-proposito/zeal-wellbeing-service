# Variables para correr zeal-wellbeing-service en el host (./mvnw spring-boot:run). Valores de DESARROLLO: nunca reales.
# Tabla completa y descripción: GUIA_PASO_A_PASO_BACKEND.md (zeal-infra-compose), sección 7.
APP_TIME_ZONE=America/Bogota
AUTH_COOKIE_SECURE=true
CACHE_TTL=60s
CORS_ALLOWED_ORIGINS=http://localhost:3000
DB_PASSWORD=zeal_password
DB_POOL_CONNECTION_TIMEOUT=10000
DB_POOL_MIN_IDLE=5
DB_POOL_SIZE=20
DB_URL=jdbc:postgresql://localhost:5432/zeal_wellbeing_db
DB_USERNAME=zeal_user
DEMO_DATA_ENABLED=true
FRONTEND_URL=http://localhost:3000
JWT_ISSUER=zeal
JWT_SECRET=ZealMVP2026ArchitectureSoftwareSecretKeyMinimum256Bits!!
JWT_TTL=15m
LIVEKIT_API_KEY=zeal-dev
LIVEKIT_API_SECRET=ZealLiveKitDevSecretKeyMinimum32Chars!!
LIVEKIT_PUBLIC_URL=/livekit
LOG_FORMAT=logstash
OIDC_AUTHORIZATION_URI=
OIDC_CLIENT_ID=zeal-local
OIDC_CLIENT_SECRET=zeal-local-secret
OIDC_ISSUER_URI=http://localhost:8090/microsoft
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
PG_LOCK_TIMEOUT=5s
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REFRESH_REMEMBER_TTL=30d
REFRESH_REUSE_GRACE=0s
REFRESH_SESSION_TTL=12h
ROOM_ICE_SERVERS=stun:stun.l.google.com:19302
SERVER_PORT=8081
SHUTDOWN_TIMEOUT=20s
TOMCAT_MAX_THREADS=200
TURN_CREDENTIAL_TTL=2h
TURN_SECRET=
TURN_URLS=
